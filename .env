# ========== DISCORD BOT CONFIGURATION ==========
# Get your BOT_TOKEN from: https://discord.com/developers/applications
# Click your app → Bot → Copy TOKEN
BOT_TOKEN=paste_your_bot_token_here

# Optional: Server ID for testing commands
# Right-click server in Discord (with Dev Mode ON) → Copy Server ID
GUILD_ID=

# ========== DASHBOARD SETTINGS ==========
# Dashboard runs on this port
PORT=3000

# Optional: Dashboard Authentication (set both to enable)
DASHBOARD_USER=
DASHBOARD_PASS=

# ========== MUSIC SETTINGS ==========
# Default volume (1-10000)
DEFAULT_VOLUME=5000

# Default bass (1-100)
DEFAULT_BASS=50

# Enable punk mode by default
PUNK_MODE=false
