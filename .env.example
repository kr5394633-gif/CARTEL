# Discord Developer Portal se milega -> https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: agar sirf ek server (guild) me turant test karna hai to guild ID daalo
# Isse slash commands turant register ho jaate hain (global commands me ~1hr lag sakta hai)
GUILD_ID=your_test_server_id_here

# ---------- RED EXE Dashboard ----------
# Port the dashboard's web server listens on. Railway sets this automatically —
# leave it unset in production; only set it for local testing (e.g. 3000).
PORT=3000

# Optional: protect the dashboard with a username/password (HTTP Basic Auth).
# If both are left unset, anyone with the dashboard URL can view it.
DASHBOARD_USER=
DASHBOARD_PASS=

